<UserControl x:Class="AppUsageTracker.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AppUsageTracker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">
    <!-- 图表需要真实高度，页面整体铺满而不是套在滚动区里。 -->
    <Grid Margin="26,22,26,26" MinHeight="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Overview.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding TodayLabel}"
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding PauseButtonText}"
                    Command="{Binding TogglePauseCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="7"
                            Background="{DynamicResource Brush.Primary}">
                        <TextBlock Text="{Binding CurrentAppInitials}" Foreground="White"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentAppName}" FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentStateText}"
                                   Foreground="{DynamicResource Brush.Success}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Overview.ContinuousUse}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding CurrentSessionDuration}" FontSize="20"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Overview.TodayTotal}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding CurrentAppTodayDuration}" FontSize="20"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Overview.TodayEffective}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding TodayTotalDuration}" FontSize="24"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Overview.TopApp}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding TopAppName}" FontSize="22"
                               TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Overview.SwitchCount}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding SwitchCount}" FontSize="22" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Loc.Overview.Longest}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding LongestSession}" FontSize="16" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc.Overview.Timeline}"
                                   Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}" FontSize="11"
                                   Text="{DynamicResource Loc.Overview.ChartHint}" />
                    </Grid>

                    <controls:ZoomableBarChart
                        x:Name="TimelineChartControl" Grid.Row="1"
                        MinHeight="180" Margin="0,14,0,0"
                        Data="{Binding TimelineChart}"
                        HighlightedSeriesKey="{Binding HighlightedSeriesKey, Mode=TwoWay}"
                        AxisBrush="{DynamicResource Brush.Border}"
                        LabelBrush="{DynamicResource Brush.Muted}"
                        SurfaceBrush="{DynamicResource Brush.Surface}"
                        Visibility="{Binding TimelineChart.HasData,
                        Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Row="1" Text="{DynamicResource Loc.Overview.NoData}"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding TimelineChart.HasData,
                               Converter={StaticResource InverseBoolToVisibility}}" />

                    <controls:ChartLegend Grid.Row="2" Margin="0,12,0,0"
                                          ItemsSource="{Binding TimelineChart.Series}"
                                          HighlightedSeriesKey="{Binding HighlightedSeriesKey,
                                          Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Overview.Ranking}" Style="{StaticResource Text.SectionTitle}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Ranking}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28">
                                            <Border CornerRadius="5"
                                                    Background="{Binding ColorBrush}"
                                                    Visibility="{Binding HasIcon,
                                                    Converter={StaticResource
                                                    InverseBoolToVisibility}}">
                                                <TextBlock Text="{Binding Initials}"
                                                           Foreground="White" FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="24" Height="24"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon,
                                                   Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <ProgressBar Value="{Binding Percentage}" Maximum="100"
                                                         Height="4" Margin="0,6,0,0"
                                                         Foreground="{Binding ColorBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="AppUsageTracker.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AppUsageTracker.Controls">
    <!-- 图表需要真实高度，页面整体铺满而不是套在滚动区里。 -->
    <Grid Margin="26,22,26,26" MinHeight="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="统计分析" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="查看使用趋势与时间分布"
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹" Command="{Binding PreviousPeriodCommand}" />
                <TextBlock Text="{Binding RangeLabel}" MinWidth="150"
                           TextAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Content="›" Command="{Binding NextPeriodCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Content="日" GroupName="Period" Style="{StaticResource NavButton}"
                         Command="{Binding SelectPeriodCommand}" CommandParameter="Day" />
            <RadioButton Content="周" GroupName="Period" Style="{StaticResource NavButton}"
                         Command="{Binding SelectPeriodCommand}" CommandParameter="Week"
                         IsChecked="True" />
            <RadioButton Content="月" GroupName="Period" Style="{StaticResource NavButton}"
                         Command="{Binding SelectPeriodCommand}" CommandParameter="Month" />
            <RadioButton Content="年" GroupName="Period" Style="{StaticResource NavButton}"
                         Command="{Binding SelectPeriodCommand}" CommandParameter="Year" />
            <RadioButton Content="全部" GroupName="Period" Style="{StaticResource NavButton}"
                         Command="{Binding SelectPeriodCommand}" CommandParameter="All" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="总有效时长" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding TotalDuration}" FontSize="21" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding ChangeText}" Foreground="{DynamicResource Brush.Success}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="2,0,4,0">
                <StackPanel>
                    <TextBlock Text="日均时长" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding AverageDuration}" FontSize="21" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,2,0">
                <StackPanel>
                    <TextBlock Text="使用最多" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding TopAppName}" FontSize="21" Margin="0,7,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="最长连续使用" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding LongestDuration}" FontSize="21" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ChartTitle}"
                                   Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}" FontSize="11"
                                   Text="滚轮缩放 · 拖拽平移 · 双击复位" />
                    </Grid>

                    <controls:ZoomableBarChart Grid.Row="1" MinHeight="200" Margin="0,14,0,0"
                                               Data="{Binding DailyChart}"
                                               HighlightedSeriesKey="{Binding
                                               HighlightedSeriesKey, Mode=TwoWay}"
                                               AxisBrush="{DynamicResource Brush.Border}"
                                               LabelBrush="{DynamicResource Brush.Muted}"
                                               SurfaceBrush="{DynamicResource Brush.Surface}"
                                               Visibility="{Binding DailyChart.HasData,
                                               Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Row="1" Text="该区间暂无记录"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding DailyChart.HasData,
                               Converter={StaticResource InverseBoolToVisibility}}" />

                    <controls:ChartLegend Grid.Row="2" Margin="0,12,0,0"
                                          ItemsSource="{Binding DailyChart.Series}"
                                          HighlightedSeriesKey="{Binding HighlightedSeriesKey,
                                          Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="软件排行" Style="{StaticResource Text.SectionTitle}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Ranking}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Ghost}"
                                            Padding="0,2" MinHeight="0"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectAppCommand,
                                            RelativeSource={RelativeSource
                                            AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28" Height="28">
                                                <Border CornerRadius="5"
                                                        Background="{Binding ColorBrush}"
                                                        Visibility="{Binding HasIcon,
                                                        Converter={StaticResource
                                                        InverseBoolToVisibility}}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               Foreground="White" FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Icon}"
                                                       Width="24" Height="24"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon,
                                                       Converter={StaticResource
                                                       BoolToVisibility}}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="7,0">
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <ProgressBar Value="{Binding Percentage}"
                                                             Maximum="100" Height="4"
                                                             Margin="0,6,0,0"
                                                             Foreground="{Binding ColorBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedAppDetail}"
                               Style="{StaticResource Text.Muted}" Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

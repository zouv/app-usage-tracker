<UserControl x:Class="AppUsageTracker.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AppUsageTracker.Controls">
    <!-- 图表需要真实高度，页面整体铺满而不是套在滚动区里。 -->
    <Grid Margin="26,22,26,26" MinHeight="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Statistics.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{DynamicResource Loc.Statistics.Subtitle}"
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹" Command="{Binding PreviousPeriodCommand}" />
                <TextBlock Text="{Binding RangeLabel}" MinWidth="150"
                           TextAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button Content="›" Command="{Binding NextPeriodCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource SegmentedTrack}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource Loc.Statistics.Day}" GroupName="Period"
                                 Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding SelectedPeriod,
                                 Converter={StaticResource EnumEquals}, ConverterParameter=Day}" />
                    <RadioButton Content="{DynamicResource Loc.Statistics.Week}" GroupName="Period"
                                 Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding SelectedPeriod,
                                 Converter={StaticResource EnumEquals}, ConverterParameter=Week}" />
                    <RadioButton Content="{DynamicResource Loc.Statistics.Month}" GroupName="Period"
                                 Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding SelectedPeriod,
                                 Converter={StaticResource EnumEquals}, ConverterParameter=Month}" />
                    <RadioButton Content="{DynamicResource Loc.Statistics.Year}" GroupName="Period"
                                 Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding SelectedPeriod,
                                 Converter={StaticResource EnumEquals}, ConverterParameter=Year}" />
                    <RadioButton Content="{DynamicResource Loc.Statistics.All}" GroupName="Period"
                                 Style="{StaticResource SegmentedItem}"
                                 IsChecked="{Binding SelectedPeriod,
                                 Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Statistics.Total}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding TotalDuration}" Style="{StaticResource Text.StatValue}" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding ChangeText}"
                               FontSize="{StaticResource FontSize.Caption}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeKind}" Value="success">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeKind}" Value="danger">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Statistics.DailyAvg}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding AverageDuration}" Style="{StaticResource Text.StatValue}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Statistics.TopApp}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding TopAppName}" Style="{StaticResource Text.StatValue}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Statistics.Longest}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding LongestDuration}" Style="{StaticResource Text.StatValue}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ChartTitle}"
                                   Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}" FontSize="11"
                                   Text="{DynamicResource Loc.Overview.ChartHint}" />
                    </Grid>

                    <controls:ZoomableBarChart Grid.Row="1" MinHeight="200" Margin="0,14,0,0"
                                               Data="{Binding DailyChart}"
                                               HighlightedSeriesKey="{Binding
                                               HighlightedSeriesKey, Mode=TwoWay}"
                                               AxisBrush="{DynamicResource Brush.Border}"
                                               LabelBrush="{DynamicResource Brush.Muted}"
                                               SurfaceBrush="{DynamicResource Brush.Surface}"
                                               Visibility="{Binding DailyChart.HasData,
                                               Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Row="1" Text="{DynamicResource Loc.Statistics.NoData}"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding DailyChart.HasData,
                               Converter={StaticResource InverseBoolToVisibility}}" />

                    <controls:ChartLegend Grid.Row="2" Margin="0,12,0,0"
                                          ItemsSource="{Binding DailyChart.Series}"
                                          HighlightedSeriesKey="{Binding HighlightedSeriesKey,
                                          Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Statistics.Ranking}" Style="{StaticResource Text.SectionTitle}" />
                    <!-- 内容右侧留出滚动条空间，避免时长文字贴住轨道。 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Ranking}"
                             SelectedItem="{Binding SelectedAppRow, Mode=TwoWay}"
                             SelectionMode="Single" Margin="0,12,14,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="28" Height="28">
                                        <Border CornerRadius="5"
                                                Background="{Binding ColorBrush}"
                                                Visibility="{Binding HasIcon,
                                                Converter={StaticResource
                                                InverseBoolToVisibility}}">
                                            <TextBlock Text="{Binding Initials}"
                                                       Foreground="White" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Icon}"
                                               Width="24" Height="24"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon,
                                               Converter={StaticResource
                                               BoolToVisibility}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="7,0">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <ProgressBar Value="{Binding Percentage}"
                                                     Maximum="100" Height="4"
                                                     Margin="0,6,0,0"
                                                     Foreground="{Binding ColorBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedAppDetail}"
                               Style="{StaticResource Text.Muted}" Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

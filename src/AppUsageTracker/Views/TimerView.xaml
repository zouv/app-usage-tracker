<UserControl x:Class="AppUsageTracker.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,22,26,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Timer.Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{DynamicResource Loc.Timer.Subtitle}"
                               Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- 剩余时间与状态：关闭桌面面板时也能在页面看到倒计时反馈 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RemainingText}"
                                       FontSize="{StaticResource FontSize.Display}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                        <Setter Property="Text" Value="{DynamicResource Loc.Timer.StatusIdle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimerActive}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Loc.Timer.PanelStatusRunning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTimerPaused}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Loc.Timer.PanelStatusPaused}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Timer.Duration}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="64" Text="{Binding DurationHours, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         ToolTip="{DynamicResource Loc.Settings.Range.TimerHours}" />
                                <TextBlock Text="{DynamicResource Loc.Timer.Unit.Hours}" VerticalAlignment="Center"
                                       Margin="6,0,14,0" />
                                <TextBox Width="64" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         ToolTip="{DynamicResource Loc.Settings.Range.TimerMinutes}" />
                                <TextBlock Text="{DynamicResource Loc.Timer.Unit.Minutes}" VerticalAlignment="Center"
                                       Margin="6,0,14,0" />
                                <TextBox Width="64" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         ToolTip="{DynamicResource Loc.Settings.Range.TimerSeconds}" />
                                <TextBlock Text="{DynamicResource Loc.Timer.Unit.Seconds}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <!-- 开始与暂停/继续互斥显隐：空闲只显示开始，开始后只显示暂停/继续与停止 -->
                            <Button Content="{DynamicResource Loc.Settings.Timer.Start}"
                                    Command="{Binding StartTimerCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsTimerActive, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Command="{Binding PauseTimerCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsTimerActive, Converter={StaticResource BoolToVisibility}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="{DynamicResource Loc.Settings.Timer.Pause}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimerPaused}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource Loc.Settings.Timer.Resume}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource Loc.Settings.Timer.Stop}"
                                    Command="{Binding StopTimerCommand}"
                                    Visibility="{Binding IsTimerActive, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Loc.Settings.Timer.ShowPanel}"
                                  IsChecked="{Binding ShowPanel}" Margin="0,10,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Timer.PanelWidth}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PanelWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     ToolTip="{DynamicResource Loc.Settings.Range.TimerPanelWidth}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Timer.Pixel}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Timer.TextOpacity}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PanelTextOpacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     ToolTip="{DynamicResource Loc.Settings.Range.TimerTextOpacity}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Timer.Percent}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Timer.BaseOpacity}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PanelBaseOpacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     ToolTip="{DynamicResource Loc.Settings.Range.TimerBaseOpacity}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Timer.Percent}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Timer.EndAction}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding EndActionOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding EndAction}" />
                        </Grid>
                        <!-- 桌布底板透明度：仅结束动作为全屏桌布时显示 -->
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding IsOverlayAction, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Timer.OverlayOpacity}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding OverlayOpacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     ToolTip="{DynamicResource Loc.Settings.Range.TimerOverlayOpacity}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Timer.Percent}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Loc.Settings.Timer.Hint}"
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Brush.Danger}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
<UserControl x:Class="AppUsageTracker.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Timeline.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{DynamicResource Loc.Timeline.Subtitle}"
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="‹" Command="{Binding PreviousDayCommand}" />
                <DatePicker SelectedDate="{Binding SelectedDate}" Margin="8,0" />
                <Button Content="›" Command="{Binding NextDayCommand}" Margin="0,0,12,0" />
                <Button Content="{DynamicResource Loc.Timeline.ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Loc.Timeline.ClearDay}" Command="{Binding ClearSelectedDayCommand}"
                        Margin="0,0,8,0" />
                <Button Content="{DynamicResource Loc.Timeline.Add}" Command="{Binding AddSessionCommand}"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc.Timeline.Col.Date}" Binding="{Binding Date}" Width="110" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Timeline.Col.Time}" Binding="{Binding TimeRange}" Width="180" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Timeline.Col.App}" Binding="{Binding ApplicationName}" Width="*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Timeline.Col.Duration}" Binding="{Binding Duration}" Width="120" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Timeline.Col.Source}" Binding="{Binding Source}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                        <Button Content="{DynamicResource Loc.Timeline.Merge}" Command="{Binding MergeWithPreviousCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Timeline.MarkIdle}" Command="{Binding MarkAsIdleCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.Edit}" Command="{Binding EditSessionCommand}" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.Delete}" Command="{Binding DeleteSessionCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.RowSpan="2" Background="#55000000"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="500" Style="{StaticResource Card}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Timeline.EditTitle}" Style="{StaticResource Text.SectionTitle}"
                               Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource Loc.Timeline.Field.App}" />
                    <ComboBox ItemsSource="{Binding Apps}" SelectedItem="{Binding EditApp}"
                              DisplayMemberPath="Name" Margin="0,5,0,10" />
                    <TextBlock Text="{DynamicResource Loc.Timeline.Field.Start}" />
                    <TextBox Text="{Binding EditStart, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                             Margin="0,5,0,10" />
                    <TextBlock Text="{DynamicResource Loc.Timeline.Field.End}" />
                    <TextBox Text="{Binding EditEnd, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                             Margin="0,5,0,10" />
                    <TextBlock Text="{DynamicResource Loc.Timeline.Field.Notes}" />
                    <TextBox Text="{Binding EditNotes}" Height="60" AcceptsReturn="True"
                             Margin="0,5,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Loc.Apps.Cancel}" Command="{Binding CancelEditorCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.Save}" Command="{Binding SaveEditorCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AppUsageTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,22,26,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Settings.Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{DynamicResource Loc.Settings.Subtitle}"
                               Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Settings.Section.Language}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Section.Language}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Language}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.LanguageHint}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Style="{StaticResource Text.Muted}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Settings.Section.Startup}" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="{DynamicResource Loc.Settings.AutoStart}" IsChecked="{Binding AutoStart}" />
                        <CheckBox Content="{DynamicResource Loc.Settings.StartMinimized}" IsChecked="{Binding StartMinimized}" />
                        <CheckBox Content="{DynamicResource Loc.Settings.MinimizeToTray}"
                                  IsChecked="{Binding MinimizeToTrayOnClose}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Hotkey}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="HotkeyBox"
                                         Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True" Cursor="Hand"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                         ToolTip="{DynamicResource Loc.Settings.HotkeyTooltip}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox"
                                               BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Brush.Primary}" />
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Brush.PrimarySoft}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock x:Name="HotkeyHint" Text="{DynamicResource Loc.Settings.HotkeyCapture}"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.HotkeyAction}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Loc.Settings.HotkeyHint}"
                                   Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Settings.Section.Tracking}" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="{DynamicResource Loc.Settings.ExcludeIdle}"
                                  IsChecked="{Binding ExcludeIdleTime}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.IdleThreshold}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding IdleThresholdMinutes}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Minutes}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.ShortSwitch}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ShortSwitchSeconds}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Seconds}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.AutoSave}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding AutoSaveSeconds}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Seconds}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.History}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MaxHistoryDays}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Days}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Settings.Section.Notifications}" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="{DynamicResource Loc.Settings.Notifications}"
                                  IsChecked="{Binding NotificationsEnabled}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.DailySummary}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding DailySummaryHour}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Settings.Hour}" VerticalAlignment="Center"
                                       Margin="8,0,12,0" />
                            <TextBox Grid.Column="3" Text="{Binding DailySummaryMinute}" />
                            <TextBlock Grid.Column="4" Text="{DynamicResource Loc.Settings.DailySummaryHint}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Style="{StaticResource Text.Muted}" />
                        </Grid>
                        <CheckBox Content="{DynamicResource Loc.Settings.SaveWindowTitles}"
                                  IsChecked="{Binding SaveWindowTitles}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.Settings.Theme}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding Theme}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.Settings.Section.Data}" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Loc.Settings.OpenData}" Command="{Binding OpenDataDirectoryCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Loc.Settings.Backup}" Command="{Binding BackupCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Loc.Settings.Restore}" Command="{Binding RestoreBackupCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Loc.Settings.Validate}" Command="{Binding ValidateDataCommand}" />
                            <Button Content="{DynamicResource Loc.Settings.ClearHistory}" Command="{Binding ClearHistoryCommand}"
                                    Margin="8,0,0,0" Foreground="{DynamicResource Brush.Danger}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="© zouv"
                           Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

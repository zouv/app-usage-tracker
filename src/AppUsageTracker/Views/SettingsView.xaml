<UserControl x:Class="AppUsageTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,22,26,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="调整应用行为、统计规则与数据管理（修改即时生效）"
                               Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="启动与后台" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="开机时自动启动" IsChecked="{Binding AutoStart}" />
                        <CheckBox Content="启动后最小化" IsChecked="{Binding StartMinimized}" />
                        <CheckBox Content="关闭窗口时最小化到托盘"
                                  IsChecked="{Binding MinimizeToTrayOnClose}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局快捷键" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="HotkeyBox"
                                         Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True" Cursor="Hand"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                         ToolTip="点击输入框后按下组合键即可设置，例如 Ctrl+Alt+T">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox"
                                               BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Brush.Primary}" />
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Brush.PrimarySoft}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock x:Name="HotkeyHint" Text="按下组合键…"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="呼出 / 隐藏主窗口"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="点击上方输入框后按下组合键（如 Ctrl+Alt+T）即可自定义；按 Esc 可清空停用。"
                                   Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="前台有效统计" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="排除用户空闲时间"
                                  IsChecked="{Binding ExcludeIdleTime}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="空闲判定阈值" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding IdleThresholdMinutes}" />
                            <TextBlock Grid.Column="2" Text="分钟" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="短暂切换合并阈值" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ShortSwitchSeconds}" />
                            <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自动保存间隔" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding AutoSaveSeconds}" />
                            <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="历史记录保留" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MaxHistoryDays}" />
                            <TextBlock Grid.Column="2" Text="天" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="通知与隐私" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <CheckBox Content="启用使用提醒与每日摘要"
                                  IsChecked="{Binding NotificationsEnabled}" />
                        <CheckBox Content="保存窗口标题（可能包含敏感信息）"
                                  IsChecked="{Binding SaveWindowTitles}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding Theme}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="数据管理" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="创建备份" Command="{Binding BackupCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="恢复备份" Command="{Binding RestoreBackupCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="完整性检查" Command="{Binding ValidateDataCommand}" />
                            <Button Content="清除全部历史" Command="{Binding ClearHistoryCommand}"
                                    Margin="8,0,0,0" Foreground="{DynamicResource Brush.Danger}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="AppUsageTracker.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="26,22,26,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Apps.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{DynamicResource Loc.Apps.Subtitle}"
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Loc.Apps.Scan}" Command="{Binding ScanProcessesCommand}"
                        Margin="0,0,8,0" />
                <Button Content="{DynamicResource Loc.Apps.Add}" Command="{Binding AddNewCommand}"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Loc.Apps.SearchTooltip}" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedCategory}" Margin="0,0,10,0" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedStatus}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource Loc.Apps.Col.App}" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="5"
                                                Background="{DynamicResource Brush.SurfaceSubtle}"
                                                Margin="0,0,8,0">
                                            <Image Source="{Binding IconBase64,
                                                    Converter={StaticResource Base64Image}}"
                                                   Width="22" Height="22" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Style="{StaticResource Text.Muted}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Loc.Apps.Col.Category}"
                                            Binding="{Binding Category, Converter={StaticResource Localize}}"
                                            Width="120" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Apps.Col.Path}" Binding="{Binding ExecutablePath}" Width="3*" />
                        <DataGridTextColumn Header="{DynamicResource Loc.Apps.Col.Mode}"
                                            Binding="{Binding TrackingMode, Converter={StaticResource Localize}}"
                                            Width="100" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Loc.Apps.Col.Enabled}" Binding="{Binding Enabled}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                        <Button Content="{DynamicResource Loc.Apps.EnableAll}" Command="{Binding EnableFilteredCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.DisableAll}" Command="{Binding DisableFilteredCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.Toggle}" Command="{Binding ToggleSelectedCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.Edit}" Command="{Binding EditSelectedCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.Delete}" Command="{Binding DeleteSelectedCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3" Background="#55000000"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="560" MaxHeight="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="{DynamicResource Loc.Apps.Field.Name}" />
                        <TextBox Text="{Binding EditName}" Margin="0,5,0,10" />
                        <TextBlock Text="{DynamicResource Loc.Apps.Field.Process}" />
                        <TextBox Text="{Binding EditProcessName}" Margin="0,5,0,10" />
                        <TextBlock Text="{DynamicResource Loc.Apps.Field.Path}" />
                        <TextBox Text="{Binding EditExecutablePath}" Margin="0,5,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource Loc.Apps.Field.Category}" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding EditCategory}" Margin="0,5,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource Loc.Apps.Field.Mode}" />
                                <ComboBox ItemsSource="{Binding TrackingModes}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding EditTrackingMode}" Margin="0,5,0,10" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Loc.Apps.Field.TitleMatch}" />
                        <TextBox Text="{Binding EditWindowTitle}" Margin="0,5,0,10" />
                        <TextBlock Text="{DynamicResource Loc.Apps.Field.Color}" />
                        <TextBox Text="{Binding EditColorHex}" Margin="0,5,0,10" />
                        <CheckBox Content="{DynamicResource Loc.Apps.Field.EnableListen}" IsChecked="{Binding EditEnabled}" />
                        <CheckBox Content="{DynamicResource Loc.Apps.Field.IgnoreIdle}" IsChecked="{Binding EditIgnoreIdle}" />
                        <TextBlock Text="{DynamicResource Loc.Apps.Field.Notes}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" Height="58"
                                 Margin="0,5,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Loc.Apps.Cancel}" Command="{Binding CancelEditorCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Loc.Apps.Save}" Command="{Binding SaveEditorCommand}"
                                    Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Grid.RowSpan="3" Background="#55000000"
                Visibility="{Binding RunningProcesses.Count,
                Converter={StaticResource NonZeroCountVisibility}}">
            <Border Style="{StaticResource Card}" Width="680" Height="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Apps.SelectRunning}" Style="{StaticResource Text.SectionTitle}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RunningProcesses}"
                              SelectedItem="{Binding SelectedProcess}" IsReadOnly="True"
                              Margin="0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc.Apps.Col.Process}" Binding="{Binding ProcessName}" Width="150" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Apps.Col.WindowTitle}" Binding="{Binding WindowTitle}" Width="2*" />
                            <DataGridTextColumn Header="{DynamicResource Loc.Apps.Col.ProcessPath}" Binding="{Binding ExecutablePath}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Loc.Apps.Close}" Click="OnCloseScan" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Loc.Apps.UseSelected}" Command="{Binding UseSelectedProcessCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AppUsageTracker.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="26,22,26,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="软件管理" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="仅启用的软件会被纳入时长统计"
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="扫描运行软件" Command="{Binding ScanProcessesCommand}"
                        Margin="0,0,8,0" />
                <Button Content="+ 添加软件" Command="{Binding AddNewCommand}"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜索软件名称、进程或路径" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}" Margin="0,0,10,0" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="软件" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="5"
                                                Background="{DynamicResource Brush.SurfaceSubtle}"
                                                Margin="0,0,8,0">
                                            <Image Source="{Binding IconBase64,
                                                    Converter={StaticResource Base64Image}}"
                                                   Width="22" Height="22" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Style="{StaticResource Text.Muted}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="120" />
                        <DataGridTextColumn Header="匹配路径" Binding="{Binding ExecutablePath}" Width="3*" />
                        <DataGridTextColumn Header="模式" Binding="{Binding TrackingMode}" Width="100" />
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                        <Button Content="全部启用" Command="{Binding EnableFilteredCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="全部停用" Command="{Binding DisableFilteredCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="启用/停用" Command="{Binding ToggleSelectedCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="编辑" Command="{Binding EditSelectedCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="删除" Command="{Binding DeleteSelectedCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3" Background="#55000000"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="560" MaxHeight="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="软件名称" />
                        <TextBox Text="{Binding EditName}" Margin="0,5,0,10" />
                        <TextBlock Text="进程名" />
                        <TextBox Text="{Binding EditProcessName}" Margin="0,5,0,10" />
                        <TextBlock Text="可执行文件路径" />
                        <TextBox Text="{Binding EditExecutablePath}" Margin="0,5,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="分类" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding EditCategory}" Margin="0,5,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="统计模式" />
                                <ComboBox ItemsSource="{Binding TrackingModes}"
                                          SelectedItem="{Binding EditTrackingMode}" Margin="0,5,0,10" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="窗口标题包含（可选）" />
                        <TextBox Text="{Binding EditWindowTitle}" Margin="0,5,0,10" />
                        <TextBlock Text="颜色（#RRGGBB）" />
                        <TextBox Text="{Binding EditColorHex}" Margin="0,5,0,10" />
                        <CheckBox Content="启用监听" IsChecked="{Binding EditEnabled}" />
                        <CheckBox Content="忽略用户空闲" IsChecked="{Binding EditIgnoreIdle}" />
                        <TextBlock Text="备注" Margin="0,8,0,0" />
                        <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" Height="58"
                                 Margin="0,5,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Command="{Binding CancelEditorCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="保存" Command="{Binding SaveEditorCommand}"
                                    Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Grid.RowSpan="3" Background="#55000000"
                Visibility="{Binding RunningProcesses.Count,
                Converter={StaticResource NonZeroCountVisibility}}">
            <Border Style="{StaticResource Card}" Width="680" Height="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="选择运行中的软件" Style="{StaticResource Text.SectionTitle}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RunningProcesses}"
                              SelectedItem="{Binding SelectedProcess}" IsReadOnly="True"
                              Margin="0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" />
                            <DataGridTextColumn Header="窗口标题" Binding="{Binding WindowTitle}" Width="2*" />
                            <DataGridTextColumn Header="路径" Binding="{Binding ExecutablePath}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="关闭" Click="OnCloseScan" Margin="0,0,8,0" />
                        <Button Content="使用选中项" Command="{Binding UseSelectedProcessCommand}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

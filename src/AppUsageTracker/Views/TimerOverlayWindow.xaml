<Window x:Class="AppUsageTracker.Views.TimerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer overlay"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        AllowsTransparency="True"
        ShowInTaskbar="False" Background="Transparent" WindowStartupLocation="Manual">
    <!-- 预设桌布：深蓝→深绿渐变底板，透明度单独绑定设置；文字保持不透明，Esc 关闭。 -->
    <Grid>
        <Border Opacity="{Binding OverlayOpacityFraction}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1B2A4A" Offset="0" />
                    <GradientStop Color="#FF0E3B36" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Loc.Timer.OverlayTitle}" Foreground="White"
                       FontSize="{StaticResource FontSize.PageTitle}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Loc.Timer.OverlayHint}" Foreground="White" Opacity="0.7"
                       FontSize="{StaticResource FontSize.Subtitle}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
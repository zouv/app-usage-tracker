<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AppUsageTracker</RootNamespace>
    <AssemblyName>AppUsageTracker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <Product>软件使用时长统计工具</Product>
    <Company>zouv</Company>
    <Copyright>Copyright © zouv 2026</Copyright>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标同时用于 exe、主窗口和托盘，需随程序集嵌入 -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <!-- 界面字符串的唯一来源：同时供代码 T() 与运行时字符串字典解析。
         文件名刻意不带语言标签（Strings.zh-CN.xml 会被 MSBuild 当成卫星资源）。 -->
    <EmbeddedResource Include="Strings\Strings.Chinese.xml" />
    <EmbeddedResource Include="Strings\Strings.English.xml" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

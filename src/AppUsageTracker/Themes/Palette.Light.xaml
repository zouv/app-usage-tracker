<!--
    浅色调色板。与 Palette.Dark.xaml 的键完全一致，
    由 ThemeService 在运行时整体替换，样式一侧统一用 DynamicResource 引用。

    色阶参考现代桌面应用（Linear / Notion / VS Code）：
    - 灰阶 6 档，背景与表面之间拉开微弱层次，避免「一片白 + 卡片描边」的纸片感；
    - 品牌色偏紫蓝（indigo），与 Windows 默认蓝拉开差异；
    - 文字三档：正文 / 次要 / 占位，分别对应 Text / Muted / Faint。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window">#FFF4F5F7</Color>
    <Color x:Key="Color.Sidebar">#FFFAFBFC</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceSubtle">#FFF6F7F9</Color>
    <Color x:Key="Color.SurfaceHover">#FFECEFF3</Color>
    <Color x:Key="Color.SurfaceActive">#FFE2E7ED</Color>
    <Color x:Key="Color.Text">#FF1A1D21</Color>
    <Color x:Key="Color.Muted">#FF5F6B76</Color>
    <Color x:Key="Color.Faint">#FF9AA4AE</Color>
    <Color x:Key="Color.Border">#FFE4E8EC</Color>
    <Color x:Key="Color.BorderStrong">#FFD0D6DC</Color>
    <Color x:Key="Color.Primary">#FF5B5BD6</Color>
    <Color x:Key="Color.PrimaryHover">#FF4A4AC2</Color>
    <Color x:Key="Color.PrimarySoft">#FFEDEDFB</Color>
    <Color x:Key="Color.Success">#FF0E9F6E</Color>
    <Color x:Key="Color.Danger">#FFDC4C4C</Color>
    <Color x:Key="Color.Warning">#FFD97706</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.SurfaceSubtle}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfaceActive" Color="{StaticResource Color.SurfaceActive}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Faint" Color="{StaticResource Color.Faint}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource Color.PrimarySoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
</ResourceDictionary>

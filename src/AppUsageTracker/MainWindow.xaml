<Window x:Class="AppUsageTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件使用时长统计工具"
        Width="1200" Height="780"
        MinWidth="960" MinHeight="640"
        Icon="Assets/app.ico"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid Margin="12,20,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="9,0,0,22">
                    <Image Source="Assets/app.ico" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="时迹" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavButton}" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="Overview">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="概览" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Apps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="软件管理" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Statistics">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="统计分析" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Timeline">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="时间记录" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="设置" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Separator Margin="0,0,0,12" />
                    <Button Command="{Binding TogglePrivateModeCommand}"
                            Style="{StaticResource Button.Ghost}"
                            HorizontalContentAlignment="Left"
                            ToolTip="隐私模式期间不记录软件使用">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ListenerStatus}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.Muted}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding SelectedPage}" />
    </Grid>
</Window>
